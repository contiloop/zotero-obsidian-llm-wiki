# Copy to System/Telegram/.env (gitignored). Create the bot with @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# Optional. Only messages from these Telegram user ids are accepted (comma separated).
# Leave empty on the first run; the script prints the sender id of ignored/accepted messages.
TELEGRAM_ALLOWED_USER_IDS=

# Optional. A plain text you send within this many seconds after a forward becomes its **Note:**.
TELEGRAM_COMMENT_WINDOW_SECONDS=180
